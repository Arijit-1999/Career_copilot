# Career Copilot Environment Configuration

# App
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-this-to-a-secure-random-secret-key-for-production

# Database (PostgreSQL + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=career_copilot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/career_copilot
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/career_copilot

# Logging
LOG_LEVEL=INFO

# LLM Providers Configuration
# Choose your active default provider: groq | gemini | ollama | openrouter | openai | anthropic | custom
DEFAULT_LLM_PROVIDER=groq

# 1. Groq (Recommended for lightning fast open-source LLaMA 3.3, DeepSeek, Mixtral)
# Get free key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

# 2. Google Gemini (Gemini 2.5 Flash / 3.7 Flash)
# Get key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.5-flash

# 3. Ollama (100% Local, Free & Offline Open Source)
# Install from: https://ollama.ai/ (e.g. ollama run llama3.2 or qwen2.5-coder)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2

# 4. OpenRouter (Universal Aggregator for Claude, DeepSeek, LLaMA, Mistral)
# Get key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=meta-llama/llama-3.3-70b-instruct

# 5. OpenAI (GPT-4o, GPT-4o-mini)
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# 6. Anthropic Claude (Claude 3.5 Sonnet / Haiku)
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-20241022

# 7. Custom OpenAI-Compatible Local Inference (vLLM, LM Studio, LocalAI, Ollama OpenAI port)
CUSTOM_LLM_BASE_URL=http://localhost:1234/v1
CUSTOM_LLM_API_KEY=not-needed
CUSTOM_LLM_MODEL=local-model
